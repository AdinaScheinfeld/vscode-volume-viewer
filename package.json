{
  "name": "vscode-volume-viewer",
  "displayName": "Volume Viewer (remote-safe)",
  "description": "View 3D medical image volumes (.nii / .nii.gz) with label overlays in a VS Code tab. Works over Remote-SSH.",
  "version": "0.1.0",
  "publisher": "AdiSchein",
  "author": "Adina Scheinfeld",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdinaScheinfeld/vscode-volume-viewer.git"
  },
  "homepage": "https://github.com/AdinaScheinfeld/vscode-volume-viewer#readme",
  "bugs": {
    "url": "https://github.com/AdinaScheinfeld/vscode-volume-viewer/issues"
  },
  "keywords": ["nifti", "nii", "medical imaging", "mri", "ct", "segmentation", "niivue", "remote-ssh"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Visualization"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "volumeViewer.viewer",
        "displayName": "Volume Viewer (remote-safe)",
        "selector": [
          { "filenamePattern": "*.nii" },
          { "filenamePattern": "*.nii.gz" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies -o vscode-volume-viewer.vsix"
  },
  "devDependencies": {
    "@niivue/niivue": "0.68.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
