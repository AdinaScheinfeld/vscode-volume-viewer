{
  "name": "vscode-volume-viewer",
  "displayName": "Volume Viewer (remote-safe)",
  "description": "View medical images in a VS Code tab: NIfTI volumes with label overlays and DICOM clips such as ultrasound. Works over Remote-SSH.",
  "version": "0.3.1",
  "publisher": "AdiSchein",
  "author": "Adina Scheinfeld",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdinaScheinfeld/vscode-volume-viewer.git"
  },
  "homepage": "https://github.com/AdinaScheinfeld/vscode-volume-viewer#readme",
  "bugs": {
    "url": "https://github.com/AdinaScheinfeld/vscode-volume-viewer/issues"
  },
  "keywords": ["nifti", "nii", "dicom", "ultrasound", "medical imaging", "mri", "ct", "segmentation", "niivue", "remote-ssh"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Visualization"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "volumeViewer.openDicomFolder",
        "title": "Open DICOM folder in Volume Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "volumeViewer.openDicomFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@99"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "volumeViewer.viewer",
        "displayName": "Volume Viewer (remote-safe)",
        "selector": [
          { "filenamePattern": "*.nii" },
          { "filenamePattern": "*.nii.gz" },
          { "filenamePattern": "*.dcm" },
          { "filenamePattern": "*.dicom" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies -o vscode-volume-viewer.vsix"
  },
  "devDependencies": {
    "@niivue/niivue": "0.68.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.80.0",
    "@niivue/dcm2niix": "1.4.20261029",
    "dicom-parser": "1.8.21",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
